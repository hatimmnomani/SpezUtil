{
  "name": "@spezutil/lud-codec",
  "version": "0.1.0",
  "description": "Lisan ud-Dawat text codec: legacy-font typing (Al Kanz, Al-Fatemi, Kanz al-Marjaan) <-> Unicode, one data profile per font.",
  "license": "Apache-2.0",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hatimmnomani/SpezUtil.git",
    "directory": "packages/lud-codec"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./profiles/*": "./profiles/*"
  },
  "files": ["dist", "profiles"],
  "scripts": { "build": "tsup", "test": "vitest run", "lint": "tsc --noEmit" },
  "devDependencies": { "tsup": "^8.3.0", "typescript": "^5.6.0", "vitest": "^2.1.0" }
}
